<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DndCompanion.ViewModels"
             x:Class="DndCompanion.Views.LocationDetailPage"
             x:DataType="vm:LocationDetailViewModel"
             BackgroundColor="#121212"
             Title="Dettaglio Luogo">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="8">

        <Grid Grid.Row="0"
              Padding="16,12,16,0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Name}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#E8E8E8"
                       LineBreakMode="TailTruncation"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="{Binding CampaignName}"
                       FontSize="12"
                       TextColor="#7A7A7A" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Salva"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="16,8"
                    BackgroundColor="#B08D57"
                    TextColor="#1A1A1A"
                    CornerRadius="10"
                    VerticalOptions="Center"
                    Clicked="OnSaveClicked" />
        </Grid>

        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               IsVisible="{Binding HasStatusMessage}"
               FontSize="13"
               TextColor="#9E9E9E"
               Padding="16,0,16,4"
               LineBreakMode="WordWrap" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="16">

                <Border BackgroundColor="#1C1C1C"
                        Stroke="#2E2E2E"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Dettagli"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#B08D57" />
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nome" FontSize="11" TextColor="#7A7A7A" />
                            <Entry Text="{Binding Name}" Placeholder="Nome" BackgroundColor="#161616" TextColor="#E8E8E8" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Descrizione" FontSize="11" TextColor="#7A7A7A" />
                            <Editor Text="{Binding Description}"
                                    Placeholder="Descrizione del luogo..."
                                    BackgroundColor="#161616"
                                    TextColor="#D8D8D8"
                                    HeightRequest="100" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Note" FontSize="11" TextColor="#7A7A7A" />
                            <Editor Text="{Binding Notes}"
                                    Placeholder="Note sul luogo..."
                                    BackgroundColor="#161616"
                                    TextColor="#D8D8D8"
                                    HeightRequest="120" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Linked quests -->
                <Border BackgroundColor="#1C1C1C"
                        Stroke="#2E2E2E"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Quest collegate"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#B08D57" />
                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding LinkedQuests}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:QuestItemViewModel">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding Title}"
                                                   FontSize="14"
                                                   TextColor="#E8E8E8"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   TextColor="{Binding StatusColor}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding StatusColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="8,3"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding StatusText}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="#1A1A1A" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="Nessuna quest collegata a questo luogo"
                               IsVisible="{Binding HasNoLinkedQuests}"
                               FontSize="13"
                               TextColor="#7A7A7A" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Salva luogo"
                        FontSize="16"
                        FontAttributes="Bold"
                        BackgroundColor="#B08D57"
                        TextColor="#1A1A1A"
                        CornerRadius="12"
                        MinimumHeightRequest="52"
                        Clicked="OnSaveClicked" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#B08D57"
                                   Margin="0,12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>