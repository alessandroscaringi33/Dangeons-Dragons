<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DndCompanion.ViewModels"
             x:Class="DndCompanion.Views.CharactersPage"
             x:DataType="vm:CharactersViewModel"
             BackgroundColor="#121212"
             Title="Personaggi">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sessione"
                     Clicked="OnSessionClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          ColumnDefinitions="*"
          Padding="16"
          RowSpacing="12">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="{Binding CampaignName}"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#E8E8E8"
                   LineBreakMode="TailTruncation"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Personaggi giocanti"
                   FontSize="13"
                   TextColor="#7A7A7A"
                   SemanticProperties.Description="Personaggi della campagna" />
        </VerticalStackLayout>

        <!-- Status message -->
        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               IsVisible="{Binding HasStatusMessage}"
               FontSize="14"
               TextColor="#9E9E9E"
               LineBreakMode="WordWrap" />

        <!-- Character list -->
        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Characters}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Default">

                <CollectionView.EmptyView>
                    <VerticalStackLayout IsVisible="{Binding HasNoCharacters}"
                                         Spacing="12"
                                         Padding="0,48"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center">
                        <Label Text="Nessun personaggio"
                               FontSize="18"
                               TextColor="#9E9E9E"
                               HorizontalOptions="Center" />
                        <Label Text="Aggiungi il primo personaggio per iniziare."
                               FontSize="14"
                               TextColor="#7A7A7A"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterItemViewModel">
                        <Border BackgroundColor="#1C1C1C"
                                Stroke="#2E2E2E"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="16"
                                Margin="0,0,0,10">

                            <VerticalStackLayout Spacing="10">

                                <!-- Header row -->
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}"
                                               FontSize="19"
                                               FontAttributes="Bold"
                                               TextColor="#E8E8E8"
                                               LineBreakMode="TailTruncation"
                                               SemanticProperties.HeadingLevel="Level3" />
                                        <Label Text="{Binding RaceClassText}"
                                               FontSize="13"
                                               TextColor="#9E9E9E"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding LevelText}"
                                               FontSize="12"
                                               TextColor="#7A7A7A" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="8"
                                                           VerticalOptions="Start">
                                        <Label Text="{Binding HpStatusText}"
                                               FontSize="12"
                                               TextColor="{Binding HpStatusColor}"
                                               VerticalOptions="Center" />
                                        <Button Text="Apri"
                                                FontSize="13"
                                                Padding="12,6"
                                                BackgroundColor="#B08D57"
                                                TextColor="#1A1A1A"
                                                CornerRadius="8"
                                                Clicked="OnOpenCharacterClicked"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <!-- Conditions -->
                                <Label Text="{Binding ConditionsText}"
                                       IsVisible="{Binding HasConditions}"
                                       FontSize="12"
                                       TextColor="{Binding ConditionsColor}"
                                       LineBreakMode="WordWrap" />

                                <!-- HP bar -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding HpText}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{Binding HpTextColor}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding TemporaryHpText}"
                                               FontSize="13"
                                               TextColor="#4FC3F7" />
                                    </Grid>
                                    <ProgressBar Progress="{Binding HpProgress}"
                                                 ProgressColor="{Binding HpProgressColor}"
                                                 HeightRequest="10"
                                                 BackgroundColor="#2E2E2E" />
                                </VerticalStackLayout>

                                <!-- Quick HP controls -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                      ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Text="− HP"
                                            FontSize="13"
                                            Padding="12,6"
                                            BackgroundColor="#3A1F1F"
                                            TextColor="#EF5350"
                                            CornerRadius="8"
                                            Clicked="OnDamageClicked"
                                            CommandParameter="{Binding .}" />
                                    <Label Grid.Column="1"
                                           Text="Danno / cura"
                                           FontSize="12"
                                           TextColor="#7A7A7A"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Text="+ HP"
                                            FontSize="13"
                                            Padding="12,6"
                                            BackgroundColor="#1E2B22"
                                            TextColor="#4CAF50"
                                            CornerRadius="8"
                                            Clicked="OnHealClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="3"
                                            Text="Imposta"
                                            FontSize="13"
                                            Padding="12,6"
                                            BackgroundColor="#2E2E2E"
                                            TextColor="#E8E8E8"
                                            CornerRadius="8"
                                            Clicked="OnSetHpClicked"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="4"
                                            Text="Elimina"
                                            FontSize="13"
                                            Padding="12,6"
                                            BackgroundColor="#2A2A2A"
                                            TextColor="#9E9E9E"
                                            CornerRadius="8"
                                            Clicked="OnDeleteClicked"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="#B08D57"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>

        <!-- New character -->
        <Button Grid.Row="3"
                Text="Nuovo personaggio"
                Clicked="OnNewCharacterClicked"
                FontSize="16"
                FontAttributes="Bold"
                BackgroundColor="#B08D57"
                TextColor="#1A1A1A"
                CornerRadius="12"
                MinimumHeightRequest="52" />
    </Grid>

</ContentPage>